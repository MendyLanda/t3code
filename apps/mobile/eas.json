{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "development",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "distribution": "internal"
    },
    "personal": {
      "extends": "preview",
      "node": "24.13.1",
      "corepack": false,
      "pnpm": "11.10.0",
      "channel": "personal",
      "autoIncrement": true,
      "env": {
        "T3CODE_MOBILE_FORK": "1",
        "MOBILE_VERSION_POLICY": "fingerprint"
      }
    },
    "personal:testflight": {
      "extends": "personal",
      "distribution": "store"
    },
    "preview:dev": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "preview",
        "MOBILE_VERSION_POLICY": "fingerprint",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "preview",
      "environment": "preview",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "v2-preview": {
      "extends": "production",
      "distribution": "store",
      "channel": "v2-preview",
      "env": {
        "T3CODE_MOBILE_UPDATES_ENABLED": "0"
      }
    },
    "production": {
      "corepack": true,
      "env": {
        "APP_VARIANT": "production",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      },
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "personal:testflight": {
      "ios": {
        "ascAppId": "6820554865",
        "appleTeamId": "XGJZJY33WG",
        "groups": ["Personal"]
      }
    },
    "v2-preview": {
      "extends": "production",
      "android": {
        "track": "v2",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6787819824"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
